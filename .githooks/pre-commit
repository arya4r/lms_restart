#!/bin/sh
# Runs the backend tests before every commit, so a broken change is not committed.
# Set up once per clone: git config core.hooksPath .githooks   (scripts/setup does this)
# To skip in an emergency: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
cd "$root/backend" || exit 1
if [ -x .venv/bin/python ]; then py=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then py=.venv/Scripts/python.exe
else py=python3; fi
if ! "$py" -m pytest -q; then
  echo "Tests failed, so the commit was blocked. Fix them, or run git commit --no-verify to skip."
  exit 1
fi
