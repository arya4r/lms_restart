# Copy to .env for local Docker runs, or run scripts/setup.ps1 / scripts/setup.sh, which generate the secrets.
# .env is git-ignored. Never commit it.
#
# Production (AWS): set these in Secrets Manager / the ECS task environment, not in a file.

# Local Docker only: the database password is generated by the setup script
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Used by the app (generated locally by the setup script)
JWT_SECRET=CHANGE_ME_to_a_random_64_char_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_first_login_password
CORS_ORIGINS=http://localhost:8000
APP_ENV=production
TZ=Asia/Kolkata

# Production only (docker compose overrides this for local runs)
# DATABASE_URL=mysql+pymysql://lms_app:CHANGE_ME@your-rds-endpoint.ap-south-1.rds.amazonaws.com:3306/lms
